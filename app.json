{
  "expo": {
    "name": "Погода",
    "slug": "weather",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "weather",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.weather"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.weather"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Разрешите приложению определять местоположение для показа погоды рядом с вами."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
